<?xml version="1.0" encoding="UTF-8"?>
<svg width="500" height="500" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg" cx="50%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="60%" stop-color="#F7FAFC" />
        <stop offset="100%" stop-color="#EDF2F7" />
       </radialGradient>
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000000" flood-opacity="0.12" />
    </filter>
  </defs>
  
  <rect width="500" height="500" fill="url(#bg)" />
  
  <!-- Guide Lines (Raw only) -->
  

  <!-- Graphic Item with Soft Shadow -->
  <g filter="url(#softShadow)">
    
      <g transform="translate(250, 230)">
        <!-- Pedestal / Shadow -->
        <ellipse cx="0" cy="140" rx="90" ry="16" fill="#CBD5E0" fill-opacity="0.5" />
        <!-- Vase Body -->
        <path d="M-30,-130 L30,-130 L24,-100 C60,-60 100,-10 90,60 C80,120 40,135 35,140 L-35,140 C-40,135 -80,120 -90,60 C-100,-10 -60,-60 -24,-100 Z"
              fill="#3182CE" stroke="#FFFFFF" stroke-width="4" />
        <!-- Persian floral motifs -->
        <circle cx="0" cy="20" r="30" fill="none" stroke="#FFFFFF" stroke-width="4" />
        <path d="M0,-10 C15,-10 20,5 0,20 C-20,5 -15,-10 0,-10 Z" fill="#FFFFFF" />
        <path d="M0,50 C15,50 20,35 0,20 C-20,35 -15,50 0,50 Z" fill="#FFFFFF" />
        <path d="M-30,20 C-30,5 -15,0 0,20 C-15,40 -30,35 -30,20 Z" fill="#FFFFFF" />
        <path d="M30,20 C30,5 15,0 0,20 C15,40 30,35 30,20 Z" fill="#FFFFFF" />
      </g>
  </g>

  <rect x="20" y="20" width="170" height="36" rx="18" fill="#2B6CB0" fill-opacity="0.9" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.15))" />
       <text x="36" y="43" fill="#FFFFFF" font-family="system-ui, sans-serif" font-size="13" font-weight="bold">✨ AI STUDIO ENHANCED</text>

  <!-- Craft Title Bar -->
  <rect x="25" y="415" width="450" height="65" rx="14" fill="#1A202C" fill-opacity="0.88" />
  <text x="45" y="443" fill="#F7FAFC" font-family="system-ui, sans-serif" font-size="16" font-weight="bold">Jaipur Blue Ceramic Vase (AI Studio)</text>
  <text x="45" y="465" fill="#CBD5E0" font-family="system-ui, sans-serif" font-size="13">Studio clean white pedestal | Glaze reflection balanced | E-Commerce Ready</text>
</svg>