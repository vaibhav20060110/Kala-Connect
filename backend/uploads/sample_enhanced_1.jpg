<?xml version="1.0" encoding="UTF-8"?>
<svg width="500" height="500" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg" cx="50%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="60%" stop-color="#F7FAFC" />
        <stop offset="100%" stop-color="#EDF2F7" />
       </radialGradient>
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000000" flood-opacity="0.12" />
    </filter>
  </defs>
  
  <rect width="500" height="500" fill="url(#bg)" />
  
  <!-- Guide Lines (Raw only) -->
  

  <!-- Graphic Item with Soft Shadow -->
  <g filter="url(#softShadow)">
    
      <g transform="translate(250, 220)">
        <path d="M-130,-100 C-60,-130 60,-70 130,-100 C140,-20 120,60 130,120 C60,90 -60,140 -130,110 C-140,30 -120,-30 -130,-100 Z"
              fill="#C53030" stroke="#ECC94B" stroke-width="5" />
        <path d="M-100,-70 C-40,-100 40,-40 100,-70 M-90,-20 C-30,-50 50,10 90,-20 M-100,30 C-40,0 40,60 100,30 M-90,80 C-30,50 50,110 90,80"
              stroke="#ECC94B" stroke-width="3" stroke-dasharray="8,6" fill="none" />
        <circle cx="0" cy="0" r="45" fill="#ECC94B" fill-opacity="0.3" stroke="#ECC94B" stroke-width="3" />
        <path d="M0,-35 L10,-10 L35,0 L10,10 L0,35 L-10,10 L-35,0 L-10,-10 Z" fill="#ECC94B" />
      </g>
  </g>

  <rect x="20" y="20" width="170" height="36" rx="18" fill="#2B6CB0" fill-opacity="0.9" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.15))" />
       <text x="36" y="43" fill="#FFFFFF" font-family="system-ui, sans-serif" font-size="13" font-weight="bold">✨ AI STUDIO ENHANCED</text>

  <!-- Craft Title Bar -->
  <rect x="25" y="415" width="450" height="65" rx="14" fill="#1A202C" fill-opacity="0.88" />
  <text x="45" y="443" fill="#F7FAFC" font-family="system-ui, sans-serif" font-size="16" font-weight="bold">Banarasi Kadwa Silk Saree (AI Studio)</text>
  <text x="45" y="465" fill="#CBD5E0" font-family="system-ui, sans-serif" font-size="13">Studio backdrop removed | Balanced gold luster | Ready for E-Commerce</text>
</svg>