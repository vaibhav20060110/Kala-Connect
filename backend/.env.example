PORT=5000
# Optional: External PostgreSQL URL (e.g. postgres://user:pass@localhost:5432/kalaconnect)
# If left unset, KalaConnect automatically runs with the zero-config embedded data store!
DATABASE_URL=

# Google Gemini API Key (multimodal vision, audio transcription, dynamic pricing)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
