PORT=5000

# ====================================================================
# PostgreSQL Database Connection
# ====================================================================
# Options:
# 1. Neon Serverless Postgres (Recommended & Free):
#    DATABASE_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# 2. Supabase Postgres (Free):
#    DATABASE_URL=postgresql://postgres:yourpassword@db.xyz.supabase.co:5432/postgres
#
# 3. Local PostgreSQL (Installed on Windows):
#    DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/kalasetu
#
# If left empty, kalaSetu automatically falls back to the zero-config in-memory store!
DATABASE_URL=

# ====================================================================
# Google Gemini Generative AI API Key
# ====================================================================
# Get your FREE API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional model override (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
